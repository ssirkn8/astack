# F1 journal serif: the owner-selected starting style. Venue or task rules may override it.
font.family: serif
font.serif: Times New Roman, Times, STIXGeneral, DejaVu Serif
mathtext.fontset: stix
font.size: 9
axes.titlesize: 10
axes.labelsize: 9
xtick.labelsize: 8
ytick.labelsize: 8
legend.fontsize: 8
legend.frameon: False
axes.linewidth: 0.7
axes.spines.top: True
axes.spines.right: True
axes.grid: True
axes.axisbelow: True
grid.color: D9DADC
grid.linewidth: 0.45
xtick.direction: out
ytick.direction: out
xtick.major.size: 2.6
ytick.major.size: 2.6
xtick.major.width: 0.7
ytick.major.width: 0.7
lines.linewidth: 1.0
axes.prop_cycle: cycler("color", ["2B5F85", "B5482F", "5B7F3A", "6B5B95"])
image.cmap: cividis
figure.dpi: 150
savefig.dpi: 300
savefig.facecolor: white
svg.fonttype: none
pdf.fonttype: 42
